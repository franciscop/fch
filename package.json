{
  "name": "fch",
  "version": "6.0.10",
  "description": "Fetch interface with better promises, deduplication, defaults, etc.",
  "repository": "github:franciscop/fetch",
  "author": "Francisco Presencia <public@francisco.io> (https://francisco.io/)",
  "funding": "https://www.paypal.me/franciscopresencia/19",
  "license": "MIT",
  "keywords": [
    "fetch",
    "axios",
    "http",
    "https",
    "async",
    "ajax"
  ],
  "scripts": {
    "build": "npm run build:bundle && npm run build:types",
    "build:bundle": "bun build src/index.ts --outfile=index.min.js --minify --format=esm",
    "build:types": "tsc -p tsconfig.build.json",
    "lint": "tsc",
    "size": "echo $(gzip -c index.min.js | wc -c) bytes",
    "start": "bun test --watch",
    "test": "bun test"
  },
  "main": "index.min.js",
  "type": "module",
  "types": "index.d.ts",
  "files": [
    "index.min.js",
    "index.d.ts"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "polystore": "^0.27.1",
    "typescript": "^7.0.2"
  }
}
